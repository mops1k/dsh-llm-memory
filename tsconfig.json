{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "lib",
    "rootDir": "src",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@llm-memory/adapter/*": ["./packages/adapter/src/*"],
      "@llm-memory/ui": ["./packages/ui/src/index.ts"],
      "@llm-memory/ui/*": ["./packages/ui/src/*"],
      "@llm-memory/testkit": ["./packages/testkit/src/index.ts"]
    }
  },
  "references": [{ "path": "./packages/core" }],
  "include": ["src/**/*.ts"]
}
