{
  "name": "@llm-memory/ui",
  "version": "1.4.0",
  "private": false,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./*.js": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    }
  },
  "files": [
    "lib"
  ]
}
